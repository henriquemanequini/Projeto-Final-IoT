# --- Storage ---------------------------------------------------------------
# memoria   = sem persistência (dev/testes)
# sqlite    = SQLite local (produção self-hosted EC2 — default)
# dynamodb  = DynamoDB (legado)
MODO_STORAGE=sqlite
SQLITE_PATH=./vagas.db

# Compat: se true, ignora MODO_STORAGE e força "memoria"
MODO_LOCAL=false

# --- MQTT (Mosquitto) ------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=estacionamento
MQTT_PASSWORD=
MQTT_TOPIC=estacionamento/+/vagas
MQTT_CLIENT_ID=estacionamento-worker

# --- AWS (legado, usado só se MODO_STORAGE=dynamodb) -----------------------
AWS_REGION=us-east-1
AWS_PROFILE=default
TABELA_EVENTOS=vagas_eventos
TABELA_ESTADO=vagas_estado

# --- API -------------------------------------------------------------------
CORS_ORIGINS=*
LOG_LEVEL=INFO
